{
    "name": "@terminallyonline/plug-sdk",
    "version": "0.1.1",
    "license": "MIT",
    "description": "Production-ready React Query SDK for Gusher protocol interactions",
    "homepage": "https://plug.to",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/terminally-online/plug.git",
        "directory": "packages/sdk"
    },
    "keywords": [
        "gusher",
        "react-query",
        "ethereum",
        "defi",
        "web3",
        "sdk"
    ],
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "dev": "tsup --watch",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "zod": "^3.20.0"
    },
    "devDependencies": {
        "@types/node": "^25.3.3",
        "@types/react": "^19.2.17",
        "eslint": "^9.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.0.5"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.mjs",
            "require": "./dist/react.js"
        }
    },
    "publishConfig": {
        "access": "public"
    }
}